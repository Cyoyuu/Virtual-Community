    <tag k="amenity" v="place_of_worship"/>
    <tag k="building" v="yes"/>
    <tag k="building:architecture" v="gothic"/>
    <tag k="check_date" v="2024-11-03"/>
    <tag k="denomination" v="catholic"/>
    <tag k="description" v="Die Liebfrauenkirche ist eine gotische Kirche am Liebfrauenberg in der nördlichen Altstadt von Frankfurt am Main. Sie entstand in mehreren Bauphasen vom 14. bis zum 16. Jahrhundert und dient heute als Kloster- und als römisch-katholische Rektoratskirche."/>
    <tag k="description:en" v="The Liebfrauenkirche is a Gothic church on Liebfrauenberg in the northern part of Frankfurt am Main's historic city centre. It was built in several phases from the 14th to the 16th century and today serves as a monastery and Roman Catholic rectorate churc"/>
    <tag k="name" v="Liebfrauenkirche"/>
    <tag k="name:de" v="Liebfrauenkirche"/>
    <tag k="name:zh" v="法蘭克福聖母堂"/>
    <tag k="religion" v="christian"/>
    <tag k="toilets:wheelchair" v="yes"/>
    <tag k="tourism" v="attraction"/>
